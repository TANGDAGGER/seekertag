# Demo data is never selected implicitly. Use false for the real hackathon demo.
EXPO_PUBLIC_DEMO_MODE=false

# Supabase client configuration. Use the publishable/anon key, never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supported clusters: devnet and mainnet-beta. Runtime checks verify the RPC genesis hash.
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Required on devnet. Create a test SPL token you control; never label it SKR.
EXPO_PUBLIC_REWARD_TOKEN_MINT=
EXPO_PUBLIC_REWARD_TOKEN_DECIMALS=
EXPO_PUBLIC_REWARD_TOKEN_SYMBOL=DEV REWARD

# Mainnet uses official SKR automatically and rejects overrides that do not match:
# EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# EXPO_PUBLIC_REWARD_TOKEN_MINT=SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3
# EXPO_PUBLIC_REWARD_TOKEN_DECIMALS=6
# EXPO_PUBLIC_REWARD_TOKEN_SYMBOL=SKR
